<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No location / maps permissions: the app's scope is the user's own pantry only. -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/title_pantry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AddEditItemActivity"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.SuggestedRecipesActivity"
            android:label="@string/title_suggested" />

        <activity
            android:name=".ui.RecipeDetailActivity"
            android:label="@string/title_recipe"
            android:parentActivityName=".ui.SuggestedRecipesActivity" />

        <activity
            android:name=".ui.SettingsActivity"
            android:label="@string/title_settings" />
    </application>
</manifest>
